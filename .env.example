# Use one of these. If both are set, Gemini is used unless AI_PROVIDER=claude.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
# AI_PROVIDER=gemini
# PORT=3000

# Email for sign-up / login codes. Pick ONE (with neither, codes print in the server console).
# Gmail: turn on 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM="Dayblock <you@gmail.com>"
#
# Resend (https://resend.com): needs a verified domain to email anyone besides yourself
# RESEND_API_KEY=re_...
# EMAIL_FROM="Dayblock <codes@yourdomain.com>"
